{
  "manifest_version": 3,
  "name": "FACEIT Scout",
  "description": "Discover historical matches, open matchrooms for manual download, and upload demos to Scout.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "FACEIT Scout"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
