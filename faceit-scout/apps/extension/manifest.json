{
  "manifest_version": 3,
  "name": "FACEIT Scout",
  "description": "Find and download relevant FACEIT demos for local scouting.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "FACEIT Scout"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.faceit.com/*", "https://*.faceit.com/*"],
      "js": ["content/faceit-content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "downloads", "scripting", "storage", "tabs", "webRequest"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://www.faceit.com/*",
    "https://*.faceit.com/*",
    "https://*.amazonaws.com/*",
    "https://*.cloudfront.net/*"
  ]
}
