{
  "manifest_version": 3,
  "name": "FACEIT Scout Extension",
  "description": "Discover FACEIT matches and import up to three demos into a local or remote Scout backend.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "FACEIT Scout"
  },
  "background": {
    "scripts": [
      "background/service-worker.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.faceit.com/*",
        "https://*.faceit.com/*"
      ],
      "js": [
        "content/faceit-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://www.faceit.com/*",
    "https://*.faceit.com/*",
    "https://*.amazonaws.com/*",
    "https://*.cloudfront.net/*",
    "https://*.backblazeb2.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "faceit-scout-A@alihan",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "optional_permissions": [
    "https://*/*"
  ]
}
