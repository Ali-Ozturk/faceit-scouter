{
  "manifest_version": 3,
  "name": "FACEIT Scout Extension",
  "description": "Discover historical matches, open matchrooms for manual download, and upload demos to Scout.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "FACEIT Scout"
  },
  "background": {
    "scripts": [
      "background/service-worker.js"
    ]
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "faceit-scout-A@alihan",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "optional_permissions": [
    "https://*/*"
  ]
}
