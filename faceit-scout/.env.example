DATABASE_URL=postgresql://faceit_scout:faceit_scout@localhost:5432/faceit_scout
FACEIT_API_TOKEN=

INCOMING_DIRECTORY=./data/incoming
PROCESSING_DIRECTORY=./data/processing
COMPLETED_DIRECTORY=./data/completed
FAILED_DIRECTORY=./data/failed
DECOMPRESSED_DIRECTORY=./data/decompressed
TEMPORARY_DIRECTORY=./data/temporary

FILE_STABILITY_INTERVAL_SECONDS=1
FILE_STABILITY_REQUIRED_CHECKS=3
FILE_STABILITY_TIMEOUT_SECONDS=60

PROCESSOR_CONCURRENCY=3
KEEP_DECOMPRESSED_DEMOS=false
MAX_DEMO_BYTES=4294967296

PARSER_NAME=demoparser2
SCHEMA_VERSION=1
ANALYSIS_VERSION=1
LOG_LEVEL=INFO
OPENING_TENDENCY_PREVIEWS_ENABLED=false
